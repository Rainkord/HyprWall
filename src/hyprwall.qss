/* ═══════════════════════════════════════════════════════════
   HyprWall v0.5.0 — Glassmorphism Dark Theme
   ═══════════════════════════════════════════════════════════ */

* {
    font-family: 'Inter', 'SF Pro Text', 'Segoe UI', sans-serif;
    font-size: 13px;
    color: #e6edf3;
}

QMainWindow, QWidget#central, QScrollArea, QWidget#scrollContents {
    background: transparent;
    border: none;
}

/* ── GroupBox — Glassmorphism card ────────────────────────── */
QGroupBox {
    background: rgba(22, 27, 34, 180);
    border: 1px solid rgba(48, 54, 61, 150);
    border-radius: 16px;
    margin-top: 22px;
    padding: 16px 14px 14px 14px;
    font-weight: 600;
    color: #8b949e;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px; top: 5px;
    color: #8b949e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
}

/* ── LineEdit ─────────────────────────────────────────────── */
QLineEdit {
    background: rgba(13, 17, 23, 180);
    border: 1px solid rgba(48, 54, 61, 180);
    border-radius: 10px;
    padding: 0 14px;
    color: #e6edf3;
    selection-background-color: #388bfd;
    selection-color: #fff;
    min-height: 34px;
    max-height: 34px;
}
QLineEdit:focus {
    border: 1px solid rgba(88, 166, 255, 200);
    background: rgba(13, 17, 23, 220);
}

/* ── ComboBox — glass feel ────────────────────────────────── */
QComboBox {
    background: rgba(22, 27, 34, 200);
    border: 1px solid rgba(48, 54, 61, 180);
    border-radius: 10px;
    padding: 0 14px;
    color: #e6edf3;
    min-height: 34px;
    max-height: 34px;
    font-size: 13px;
}
QComboBox:hover {
    border: 1px solid rgba(88, 166, 255, 120);
    background: rgba(30, 35, 42, 230);
}
QComboBox:focus {
    border: 1px solid rgba(88, 166, 255, 200);
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #6e7681;
    width: 0; height: 0;
    margin-right: 10px;
}
QComboBox QAbstractItemView {
    background: rgba(22, 27, 34, 245);
    border: 1px solid rgba(48, 54, 61, 200);
    border-radius: 10px;
    selection-background-color: rgba(56, 139, 253, 20);
    color: #e6edf3;
    outline: none;
    padding: 6px;
}

/* ── QPushButton — glassmorphic ───────────────────────────── */
QPushButton {
    background: rgba(48, 54, 61, 180);
    border: 1px solid rgba(48, 54, 61, 160);
    border-radius: 10px;
    padding: 0 20px;
    color: #e6edf3;
    font-weight: 500;
    min-height: 34px;
    max-height: 34px;
    font-size: 13px;
}
QPushButton:hover {
    background: rgba(56, 139, 253, 25);
    border: 1px solid rgba(88, 166, 255, 150);
    color: #79c0ff;
}
QPushButton:pressed {
    background: rgba(56, 139, 253, 12);
}

/* Gallery add — green accent */
QPushButton#galleryAddBtn {
    background: rgba(35, 134, 54, 160);
    border: 1px solid rgba(63, 185, 80, 80);
    border-radius: 10px;
    color: #e6edf3;
    font-weight: 600;
    font-size: 12px;
    padding: 0 16px;
    min-height: 30px;
    max-height: 30px;
    min-width: 0;
}
QPushButton#galleryAddBtn:hover {
    background: rgba(35, 134, 54, 220);
    border: 1px solid rgba(63, 185, 80, 180);
    color: #3fb950;
}
QPushButton#galleryAddBtn:pressed {
    background: rgba(35, 134, 54, 200);
}

/* ── QCheckBox — modern toggle indicator ──────────────────── */
QCheckBox {
    spacing: 10px;
    color: #8b949e;
    min-height: 30px;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(48, 54, 61, 200);
    border-radius: 5px;
    background: rgba(13, 17, 23, 180);
}
QCheckBox::indicator:checked {
    background: #238636;
    border-color: #3fb950;
    image: none;
}
QCheckBox::indicator:hover {
    border-color: rgba(88, 166, 255, 150);
}

/* ── Slider — glowing groove ──────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: rgba(33, 38, 45, 200);
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #58a6ff;
    border: 2px solid #0d1117;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #79c0ff;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 9px;
    border: 2px solid rgba(13, 17, 23, 220);
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #388bfd, stop:1 #58a6ff);
    border-radius: 2px;
}

/* ── QLabel — orient label monospace pill ─────────────────── */
QLabel#orientLabel {
    color: #8b949e;
    font-size: 11px;
    font-family: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
    background: rgba(13, 17, 23, 140);
    border: 1px solid rgba(48, 54, 61, 120);
    border-radius: 8px;
    padding: 5px 12px;
}
QLabel#galleryEmpty {
    color: #484f58;
    font-size: 12px;
}
QLabel#bindHint {
    color: #58a6ff;
    font-size: 10px;
    font-family: 'JetBrains Mono', 'SF Mono', monospace;
    background: rgba(56, 139, 253, 10);
    border: 1px solid rgba(56, 139, 253, 30);
    border-radius: 6px;
    padding: 4px 8px;
}

/* ── QListWidget — gallery grid ───────────────────────────── */
QListWidget#galleryList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#galleryList::item {
    background: transparent;
    border: none;
    padding: 0;
}
QListWidget#galleryList::item:selected {
    background: transparent;
    border: none;
}

/* ── Scrollbar — frosted ──────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(110, 118, 129, 60);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(110, 118, 129, 140);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
